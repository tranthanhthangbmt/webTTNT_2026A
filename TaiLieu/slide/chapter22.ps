%%BeginDocument: figures/language-learning.ps
%!PS-Adobe-2.0 EPSF-1.2
%%Creator: idraw
%%DocumentFonts: Times-Italic Times-Roman Helvetica-Bold
%%Pages: 1
%%BoundingBox: -44 517 442 726
