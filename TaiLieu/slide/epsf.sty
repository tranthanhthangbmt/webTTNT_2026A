% epsf.sty - rewritten to use graphicx and epstopdf for seamless pdflatex integration
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{epsf}[2026/07/16 Modern replacement using graphicx]

\RequirePackage{graphicx}
\RequirePackage{epstopdf}

% Register .ps files to be converted using epstopdf just like .eps
\epstopdfDeclareGraphicsRule{.ps}{pdf}{.pdf}{epstopdf #1 --outfile=\OutputFile}

\AppendGraphicsExtensions{.ps}

% Define lengths for backward compatibility
\newlength{\epsfxsize}
\newlength{\epsfysize}
\epsfxsize=0pt
\epsfysize=0pt

% Wrapper for \epsffile
\def\epsffile#1{%
  \ifdim\epsfxsize>0pt
    \ifdim\epsfysize>0pt
      \includegraphics[width=\epsfxsize,height=\epsfysize]{#1}%
    \else
      \includegraphics[width=\epsfxsize]{#1}%
    \fi
  \else
    \ifdim\epsfysize>0pt
      \includegraphics[height=\epsfysize]{#1}%
    \else
      \includegraphics{#1}%
    \fi
  \fi
  \global\epsfxsize=0pt
  \global\epsfysize=0pt
}

% Provide \epsfbox alias just in case
\let\epsfbox\epsffile
